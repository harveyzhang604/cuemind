{
  "name": "cuemind",
  "version": "1.0.30",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test tests/*.test.js",
    "check": "node scripts/check.mjs",
    "build": "node scripts/build.mjs",
    "preview": "python3 -m http.server 4173 --bind 127.0.0.1",
    "test:browser": "node scripts/browser-tests.mjs",
    "format": "prettier --write \"extension/**/*.{js,css,html}\" \"scripts/*.mjs\" tests/release-policy.test.js",
    "format:check": "prettier --check \"extension/**/*.{js,css,html}\" \"scripts/*.mjs\" tests/release-policy.test.js"
  },
  "devDependencies": {
    "prettier": "3.6.2"
  },
  "license": "MIT",
  "description": "Local-first video reading, bilingual subtitles, replay and notes for YouTube, Bilibili and Migu.",
  "engines": {
    "node": ">=22"
  }
}
